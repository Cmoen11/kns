{
  "input": {
    "gvr": {
      "group": "external-secrets.io",
      "version": "v1beta1",
      "resource": "externalsecrets"
    },
    "object": {
      "apiVersion": "external-secrets.io/v1beta1",
      "kind": "ExternalSecret",
      "metadata": {
        "name": "db",
        "namespace": "default"
      },
      "spec": {
        "refreshInterval": "1h",
        "secretStoreRef": {
          "name": "vault",
          "kind": "ClusterSecretStore"
        },
        "target": {
          "name": "db"
        },
        "data": [
          {
            "secretKey": "password",
            "remoteRef": {
              "key": "secret/data/db",
              "property": "es-remote-prop"
            }
          }
        ],
        "dataFrom": [
          {
            "extract": {
              "key": "es-extract-key"
            }
          }
        ]
      }
    }
  },
  "expected": {
    "apiVersion": "external-secrets.io/v1beta1",
    "kind": "ExternalSecret",
    "metadata": {
      "name": "db",
      "namespace": "default"
    },
    "spec": {
      "refreshInterval": "1h",
      "secretStoreRef": {
        "name": "vault",
        "kind": "ClusterSecretStore"
      },
      "target": {
        "name": "db"
      },
      "data": {
        "redacted": "kind"
      },
      "dataFrom": {
        "redacted": "kind"
      }
    }
  },
  "rules": {
    "kind": 2
  },
  "mustNotContain": [
    "es-remote-prop",
    "es-extract-key"
  ]
}

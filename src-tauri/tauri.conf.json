{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kns",
  "version": "../package.json",
  "identifier": "no.sixm.kns",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kns",
        "width": 1440,
        "height": 900,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFQjJBQUFGN0VBOTVCMUIKUldRYlc2bCtyNnF5bmhweWp0dlVuZ2EyN0xzQTExekROYS93VUFteXlvSldPeWtpZTlsdG5JK1IK",
      "endpoints": [
        "https://github.com/Cmoen11/kns/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
